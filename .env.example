# Golm CyberLab – Konfiguration für den Docker-Betrieb.
# Kopieren nach .env und anpassen. Die .env NICHT ins Git einchecken!

# ============================ PFLICHT ============================
# Langen Zufallswert eintragen (wird vom Setup-Skript automatisch erzeugt):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CYBERLAB_SECRET_KEY=BITTE-AENDERN

# Adresse, unter der die Plattform erreichbar ist (steuert HTTP/HTTPS):
#   :80                      -> nur HTTP (einfachster Start)
#   https://192.168.5.105    -> HTTPS mit selbst signiertem Zertifikat (internes Netz)
#   cyberlab.example.org     -> HTTPS mit Let's Encrypt (öffentlicher DNS-Name)
CYBERLAB_SITE_ADDRESS=:80

# Auf 1 setzen, sobald CYBERLAB_SITE_ADDRESS HTTPS verwendet (Cookies nur über TLS):
CYBERLAB_HTTPS=0
CYBERLAB_SCHEME=http

# ====================== ANMELDUNG / KONTEN =======================
# Erst-Admin (lokales Konto) beim ersten Start anlegen:
CYBERLAB_ADMIN_USER=admin
CYBERLAB_ADMIN_EMAIL=admin@example.org
CYBERLAB_ADMIN_PASSWORD=bitte-langes-passwort-setzen

# Offene Registrierung (für Institutsbetrieb lieber aus + LDAP nutzen):
CYBERLAB_ALLOW_REGISTRATION=1
# Nur diese E-Mail-Domains zulassen (Komma-getrennt, leer = alle):
CYBERLAB_REGISTRATION_EMAIL_DOMAINS=

# --- Active Directory / LDAP (optional) ---
CYBERLAB_LDAP_ENABLED=0
CYBERLAB_LDAP_SERVER=ldaps://dc01.campus.local
CYBERLAB_LDAP_UPN_SUFFIX=campus.local
CYBERLAB_LDAP_BASE_DN=DC=campus,DC=local
CYBERLAB_LDAP_ADMIN_GROUP_DN=CN=CyberLab-Admins,OU=Gruppen,DC=campus,DC=local
CYBERLAB_LDAP_VERIFY_CERT=1

# ========================== PROXMOX ==============================
# MOCK=1: Lab-Starts werden simuliert (kein echtes Proxmox nötig – gut zum Ausprobieren).
# Für echte Übungs-VMs auf 0 setzen und Token eintragen (siehe deploy/proxmox/README.md).
CYBERLAB_PROXMOX_MOCK=1
CYBERLAB_PROXMOX_HOST=pve01.campus.local
CYBERLAB_PROXMOX_PORT=8006
CYBERLAB_PROXMOX_NODE=pve01
CYBERLAB_PROXMOX_TOKEN_ID=cyberlab@pve!platform
CYBERLAB_PROXMOX_TOKEN_SECRET=
# True, False oder Pfad zu einer CA-Datei im Container (z. B. /vpn/proxmox-ca.pem):
CYBERLAB_PROXMOX_VERIFY_SSL=1
CYBERLAB_PROXMOX_POOL=cyberlab
CYBERLAB_PROXMOX_IP_MODE=agent

# ============================= LAB ===============================
CYBERLAB_LAB_MAX_PER_USER=1
CYBERLAB_LAB_MAX_TOTAL=20
CYBERLAB_LAB_DEFAULT_MINUTES=60
# Ordner auf dem Host mit WireGuard-Profilen <benutzername>.conf (wird nach /vpn gemountet):
CYBERLAB_VPN_DIR=./vpn-profiles
CYBERLAB_LAB_VPN_CONFIG_DIR=/vpn
